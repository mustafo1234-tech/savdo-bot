# ===== Majburiy =====
# Telegram bot tokeni (@BotFather)
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Adminning Telegram ID si (raqam)
OWNER_ID=123456789
# PostgreSQL ulanish manzili (Render/Heroku uslubidagi postgres:// ham bo'ladi)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/game_marketplace
# Sirlar: kamida bittasi. O'zgartirsangiz, eski shifrlangan ma'lumotlar o'qilmaydi!
SECRET_KEY=change-me-to-a-long-random-string
# Ixtiyoriy: alohida Fernet kaliti (SECRET_KEY dan ustun turadi)
# ENCRYPTION_KEY=

# ===== Click to'lov (ixtiyoriy, lekin to'liq uchlik kerak) =====
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# CLICK_MERCHANT_USER_ID=
# Click webhook uchun tashqi HTTPS manzil (oxirida / yo'q)
# PUBLIC_BASE_URL=https://your-app.onrender.com

# ===== Web server =====
# Render PORT ni o'zi beradi; lokal uchun 8080
PORT=8080
WEB_HOST=0.0.0.0

# ===== Baza va bot xatti-harakati =====
# true bo'lsa jadvallar avtomatik yaratiladi (birinchi ishga tushirish uchun qulay)
AUTO_CREATE_TABLES=true
DEFAULT_COMMISSION=10
DEFAULT_MIN_PRICE=5000
DEFAULT_SUPPORT=@support
THROTTLE_LIMIT=8
THROTTLE_WINDOW=3
LOG_LEVEL=INFO
DEBUG=false
